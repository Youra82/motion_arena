{
  "name": "motion-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "pnpm --filter @motion-arena/mobile-web dev",
    "build": "pnpm --filter @motion-arena/mobile-web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "assets": "node scripts/fetch-assets.mjs",
    "e2e": "playwright test",
    "dev:phone": "pnpm --filter @motion-arena/mobile-web dev:phone",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "start:phone": "pnpm build && pnpm --filter @motion-arena/mobile-web preview:phone",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
