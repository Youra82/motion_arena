{
  "name": "@motion-arena/mobile-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/fetch-assets.mjs",
    "dev": "vite",
    "dev:phone": "node ../../scripts/fetch-assets.mjs && vite --host --mode phone",
    "prebuild": "node ../../scripts/fetch-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:phone": "vite preview --host --mode phone --port 4443"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "@motion-arena/motion-scoring": "workspace:*",
    "@motion-arena/pose-engine": "workspace:*",
    "@motion-arena/shared": "workspace:*",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8"
  }
}
